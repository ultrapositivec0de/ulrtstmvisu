{
  "$schema": "../schemas/capability.json",
  "identifier": "default",
  "description": "Default capabilities for the Tauri application",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "fs:default",
    "fs:allow-read-all",
    "fs:allow-write-all",
    "dialog:default"
  ]
}
